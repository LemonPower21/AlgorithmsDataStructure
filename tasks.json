{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build esercizio 3",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-std=c99", "-Wall", "-Wextra", "-g",
        "client.c", "inventario.c", "personaggi.c",
        "-o", "client.exe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}